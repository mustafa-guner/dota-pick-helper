# Copy to .env.production on the VPS and fill in real values.
# Used by docker-compose.prod.yml via: docker compose -f docker-compose.prod.yml --env-file .env.production ...

POSTGRES_USER=dota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dota_pick_helper

OLLAMA_MODEL=llama3.1

# openssl rand -hex 32
ADMIN_TOKEN_SECRET=change-me

# Only used to bootstrap the first row in admin_users when that table is empty (first boot).
# After that, users live in the database and these two are no longer read at login time.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Optional — YouTube Data API v3 key (console.cloud.google.com). If unset, video collection
# silently no-ops instead of failing boot.
YOUTUBE_API_KEY=
